# repro0511.sh — повтор всех проверок из чистой копии пакета (2026-10-25T14:30:19+05:00)
#!/bin/bash
# повтор всех проверок из самого пакета (как в README), в чистой копии
set -e
S=/tmp/claude-0/-home-claude/0ff6da26-f30f-5721-a8f9-462306d32c56/scratchpad
R=$S/release/FalloutNV_PDB_v0.5.11; P=$S/repro0511; X=$S/pdb/FalloutNV.pdb; E=$S/exe/FalloutNV.exe
rm -rf $P; cp -r $R $P; cd $P
py(){ python3 -I -B "$@"; }
py tools/make_syms.py $X syms.tsv | tail -1
py tools/evidence.py research/fnv_types_v05_research.meta.json tools/evidence_spec.json syms.tsv $E out > /dev/null
py tools/verify_change_flags.py research/fnv_types_v05_research.h $E out/change_flags.csv > /dev/null
for v in sound_msg mem_context memory_passes; do py tools/verify_$v.py research/fnv_types_v05_research.h syms.tsv $E out/$v.csv > /dev/null; done
py tools/verify_render_enums.py research/fnv_types_v05_research.h syms.tsv $E out > /dev/null
py tools/report_extras.py tools/spec.json tools/evidence_spec.json research/fnv_types_v05_research.meta.json out > /dev/null
diff -r out evidence && echo EVIDENCE-IDENTICAL
CL="clang --target=i686-pc-windows-msvc -std=c++17 -c -g -gcodeview -fstandalone-debug -fno-exceptions -fno-rtti -Wno-invalid-offsetof"
$CL -I. tools/fnv_types_v05.cpp -o s.obj && lld-link /dll /noentry /nodefaultlib /debug /pdb:s.pdb /out:s.dll s.obj
$CL -Iresearch tools/fnv_types_v05_research.cpp -o r.obj && lld-link /dll /noentry /nodefaultlib /debug /pdb:r.pdb /out:r.dll r.obj
py tools/merge_tpi.py $X s.pdb s_final.pdb | tail -1; py tools/merge_tpi.py $X r.pdb r_final.pdb | tail -1
cmp s_final.pdb FalloutNV.pdb && cmp r_final.pdb research/FalloutNV.pdb && echo PDBS-IDENTICAL
mkdir -p sb; py tools/scripts_src/build.py sb > /dev/null && diff -r sb scripts && echo SCRIPTS-IDENTICAL
py tools/pdb_vs_meta.py FalloutNV.pdb fnv_types_v05.meta.json | tail -1
py tools/pdb_vs_meta.py research/FalloutNV.pdb research/fnv_types_v05_research.meta.json | tail -1
py tools/scripts_src/test_ghidra_mock.py evidence/summary.json scripts/fnv_apply_ghidra.py | tail -2
py tools/scripts_src/test_ida_mock.py evidence/summary.json scripts/fnv_apply_ida.py | tail -2
sha256sum FalloutNV.pdb research/FalloutNV.pdb
python3 -c "import csv;print('RAW-MISMATCH', sum(r['status']=='MISMATCH' for r in csv.DictReader(open('out/evidence_vslots.csv',encoding='utf-8'))))"
python3 -I tools/test_slot_forward.py | tail -1
py tools/test_windows_check.py FalloutNV.pdb fnv_types_v05.meta.json $E test_manifest.json | grep -c '^OK'
py tools/test_windows_check.py research/FalloutNV.pdb research/fnv_types_v05_research.meta.json $E test_manifest.json | grep -c '^OK'
py tools/test_chaincheck.py $E syms.tsv | tail -1
py tools/test_chaincheck.py | tail -1
py tools/test_prefixview.py evidence/summary.json fnv_types_v05.h fnv_types_v05.meta.json | tail -1
py tools/test_prefixview.py | tail -1
py tools/msf_streams_diff.py FalloutNV.pdb s_final.pdb $X | grep -c "одинаков"
